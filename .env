# ------------------------------------------------------------------------------
# INTEGRACIÓN CON GOOGLE WORKSPACE (OAuth 2.0)
#
# Requisitos previos en Google Cloud Console:
#   1. Crear un proyecto en https://console.cloud.google.com/
#   2. Habilitar la API: "Admin SDK API" (admin.googleapis.com)
#   3. Crear credenciales OAuth 2.0 (tipo "Web Application")
#   4. Agregar URI de redirección autorizado: http://localhost:5000/google/callback
#   5. Descargar el JSON de credenciales y guardarlo en:
#      backend/credentials/google_oauth.json
#
# El flujo OAuth almacena los tokens en:
#   backend/credentials/google_token.json  (generado automáticamente tras autorizar)
#
# NOTA: Estas variables son de referencia informativa. El sistema carga
# las credenciales directamente desde el archivo google_oauth.json.
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_JSON_PATH=backend/credentials/google_oauth.json
GOOGLE_TOKEN_PATH=backend/credentials/google_token.json
# Dominio corporativo de Google Workspace para filtrar usuarios
GOOGLE_DOMAIN=renconsultores.com.co

