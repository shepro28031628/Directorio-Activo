{"file":"index-DRnH9Leq.js","mappings":";;;;;;;;;;;;;;;;;;;;;AAGA,UAAM,SAAS,IAAI,EAAE;AACrB,UAAM,sBAAsB,IAAY,EAAE;AAC1C,UAAM,qBAAqB,IAAY,EAAE;AACzC,UAAM,eAAe,IAAI,KAAK;AAE9B,UAAM,QAAQ,IAAI,KAAK;AACvB,UAAM,eAAe,IAAI,EAAE;AAQ3B,UAAM,EAAE,MAAM,SAAS,SAAS,eAAA,KAAmB,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM;AAAA,MAAgB;AAAA,MAA6B;AAAA,QACpG,OAAO,EAAE,OAAA;AAAA,MAAO;AAAA,MAClB;AAAA;AAAA,IAAA,CAAC;AAGD,UAAM,EAAE,MAAM,cAAA,KAAkB,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM;AAAA,MAAc;AAAA,MAAsB;AAAA,QACxE,OAAO,EAAE,OAAO,KAAO,MAAM,EAAA;AAAA,MAAE;AAAA,MACjC;AAAA;AAAA,IAAA,CAAC;AACD,UAAM,gBAAgB,SAAS,MAAM;AACnC,YAAM,MAAM,cAAc;AAC1B,UAAI,CAAC,IAAK,QAAO,CAAA;AACjB,YAAM,OAAO,MAAM,QAAQ,GAAG,IAAI,MAAO,IAAI,QAAQ,CAAA;AACrD,aAAO,KAAK,OAAO,CAAC,MAAW,CAAC,EAAE,gBAAgB,EAAE,WAAW,UAAU;AAAA,IAC3E,CAAC;AAGD,UAAM,EAAE,MAAM,aAAA,KAAiB,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM;AAAA,MAAgB;AAAA;;KAAmB;AAGxE,UAAM,QAAQ,MAAM;AAClB,qBAAA;AAAA,IACF,CAAC;AAED,UAAM,aAAa,CAAC,YAAoB;AACtC,UAAI,CAAC,QAAS,QAAO;AACrB,YAAM,IAAI,IAAI,KAAK,OAAO;AAC1B,YAAM,MAAM,CAAC,MAAc,OAAO,CAAC,EAAE,SAAS,GAAG,GAAG;AACpD,aAAO,GAAG,EAAE,YAAA,CAAa,IAAI,IAAI,EAAE,SAAA,IAAa,CAAC,CAAC,IAAI,IAAI,EAAE,QAAA,CAAS,CAAC,IAAI,IAAI,EAAE,SAAA,CAAU,CAAC,IAAI,IAAI,EAAE,WAAA,CAAY,CAAC;AAAA,IACpH;;mBA4COC,eAAAC,WAAA,EAAA,OAAM,eAAW,MAAA,CAAA,uqCAwBL,OAAA,KAAM;AAiCQC,oBAAAC,MAAA,OAAA,IAAV,WAAM;+SAQJ,OAAO,YAAY,MAAM,wHAGzB,OAAO,YAAY,MAAM,0NASzB,OAAO,WAAW,MAAM,kIAGxB,OAAO,WAAW,WAAW,yEAS1BC,eAAA,CAAA,OAAO,WAAM,iPAIlBC,eAAA,OAAO,WAAM,WAAA,eAAA,UAAA,kHAMf,WAAW,OAAO,cAAc,CAAA,0EAQzBD,eAAA,CAAA,OAAO,WAAM,iQAIlBC,eAAA,OAAO,WAAM,WAAA,mBAAA,gBAAA;;;AAOf,UAAAF,MAAA,OAAA,GAAS,WAAM,GAAA;;;;;y1BAsBb,oBAAA,KAAmB,oBAAnB,oBAAA,OAAmB,EAAA,kBAAnB,oBAAA,OAAmB,EAAA,CAAA,IAAA,cAAA,EAAA,iDAAA;AAIRD,oBAAA,cAAA,QAAL,MAAC;sCAAgC,SAAO,EAAE,EAAE,wDAJlD,oBAAA,KAAmB,oBAAnB,oBAAA,OAI8C,EAAE,EAAE,kBAJlD,oBAAA,OAI8C,EAAE,EAAE,CAAA,IAAA,cAAA,MACtDG,eAAA,EAAE,MAAM,MAAQA,eAAA,EAAE,MAAM;;idAWpB,mBAAA,KAAkB,oBAAlB,mBAAA,OAAkB,EAAA,kBAAlB,mBAAA,OAAkB,EAAA,CAAA,IAAA,cAAA,EAAA,gDAAA;AAILH,oBAAAC,MAAA,YAAA,IAAP,QAAG;sCAAiC,SAAO,IAAI,EAAE,wDAJvD,mBAAA,KAAkB,oBAAlB,mBAAA,OAIiD,IAAI,EAAE,kBAJvD,mBAAA,OAIiD,IAAI,EAAE,CAAA,IAAA,cAAA,MAC3DE,eAAA,IAAI,MAAM;;mHASJ,aAAA,KAAY,IAAA,cAAA,wMAGpB,aAAA,QAAY,iBAAA,6BAAA;UAUZ,MAAA,OAAK;0UAEsB,aAAA,KAAY,CAAA,YAAA;AAAA;;;;;;;;;;;;;;","names":["_withAsyncContext","_ssrRenderAttrs","_mergeProps","_ssrRenderList","_unref","_ssrRenderClass","_ssrInterpolate"],"sources":["../../../../pages/aplicaciones/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport { ref, computed, watch } from 'vue'\n\nconst search = ref('')\nconst selectedColaborador = ref<string>('')\nconst selectedAplicacion = ref<string>('')\nconst isSubmitting = ref(false)\n\nconst toast = ref(false)\nconst toastMessage = ref('')\nconst triggerToast = (msg: string) => {\n  toastMessage.value = msg\n  toast.value = true\n  setTimeout(() => { toast.value = false }, 3000)\n}\n\n// Fetch accesses\nconst { data: accesos, refresh: refreshAccesos } = await useFetch<any[]>('/api/aplicaciones/accesos', {\n  query: { search }\n})\n\n// Fetch collaborators for the dropdown\nconst { data: _colabsResult } = await useFetch<any>('/api/colaboradores', {\n  query: { limit: 10000, page: 1 }\n})\nconst colaboradores = computed(() => {\n  const raw = _colabsResult.value\n  if (!raw) return []\n  const list = Array.isArray(raw) ? raw : (raw.data || [])\n  return list.filter((c: any) => !c.eliminado_en && c.estado !== 'Retirado')\n})\n\n// Fetch applications for the dropdown\nconst { data: aplicaciones } = await useFetch<any[]>('/api/aplicaciones')\n\n// Watch search to refresh access list automatically\nwatch(search, () => {\n  refreshAccesos()\n})\n\nconst formatDate = (dateStr: string) => {\n  if (!dateStr) return '-'\n  const d = new Date(dateStr)\n  const pad = (n: number) => String(n).padStart(2, '0')\n  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`\n}\n\nconst handleToggleAcceso = async (acceso: any) => {\n  try {\n    await $fetch('/api/aplicaciones/toggle-acceso', {\n      method: 'POST',\n      body: { accesoId: acceso.id }\n    })\n    const actionMsg = acceso.estado === 'Activo' ? 'acceso revocado' : 'acceso otorgado'\n    triggerToast(`Acceso para ${acceso.colaborador.nombre} actualizado (${actionMsg}).`)\n    refreshAccesos()\n  } catch (err: any) {\n    triggerToast(`Error al actualizar acceso: ${err.message}`)\n  }\n}\n\nconst handleConcederAcceso = async () => {\n  if (!selectedColaborador.value || !selectedAplicacion.value) {\n    triggerToast('Por favor selecciona un colaborador y una aplicación.')\n    return\n  }\n\n  isSubmitting.value = true\n  try {\n    await $fetch('/api/aplicaciones/conceder', {\n      method: 'POST',\n      body: {\n        colaboradorId: Number(selectedColaborador.value),\n        aplicacionId: Number(selectedAplicacion.value)\n      }\n    })\n    triggerToast('Acceso concedido exitosamente.')\n    selectedColaborador.value = ''\n    selectedAplicacion.value = ''\n    refreshAccesos()\n  } catch (err: any) {\n    triggerToast(`Error al otorgar acceso: ${err.message}`)\n  } finally {\n    isSubmitting.value = false\n  }\n}\n</script>\n\n<template>\n  <div class=\"space-y-6\">\n    <!-- Header principal -->\n    <div class=\"flex justify-between items-center flex-wrap gap-3\">\n      <div>\n        <h1 class=\"text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white font-sans\">\n          Matriz de Accesos <span class=\"text-brand-purple\">& Aplicaciones</span>\n        </h1>\n        <p class=\"text-slate-500 text-sm\">Auditoría centralizada de permisos y licencias asignadas por colaborador.</p>\n      </div>\n      <button \n        @click=\"refreshAccesos\" \n        class=\"bg-brand-purple hover:bg-brand-purpleHover text-white font-semibold py-2 px-4 rounded-xl transition-all shadow-md shadow-brand-purple/20 flex items-center gap-2 text-sm\"\n      >\n        <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 7.89H18\"/>\n        </svg>\n        Actualizar Accesos\n      </button>\n    </div>\n\n    <!-- Buscador -->\n    <div class=\"flex flex-col md:flex-row gap-4 bg-white/70 dark:bg-slate-900/60 backdrop-blur-md p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm\">\n      <div class=\"flex-grow\">\n        <input \n          v-model=\"search\" \n          type=\"text\" \n          placeholder=\"Buscar por colaborador, correo o aplicación...\" \n          class=\"w-full px-4 py-2 border border-slate-200 dark:border-slate-800 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-purple bg-white dark:bg-slate-950 text-slate-800 dark:text-slate-200\"\n        />\n      </div>\n    </div>\n\n    <!-- Layout principal: Dos columnas -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n      \n      <!-- Panel de Control de Accesos Activos (Tabla) -->\n      <div class=\"lg:col-span-8 glass-card overflow-hidden\">\n        <div class=\"px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2\">\n          <span class=\"text-xl\">🔑</span>\n          <h2 class=\"text-base font-extrabold text-brand-purple dark:text-violet-400 font-sans tracking-wide uppercase\">\n            Control de Accesos Activos\n          </h2>\n        </div>\n\n        <div class=\"overflow-x-auto\">\n          <table class=\"w-full text-left border-collapse\">\n            <thead>\n              <tr class=\"bg-slate-50/50 dark:bg-slate-900/30 border-b border-slate-100 dark:border-slate-800 text-[10px] font-bold text-[#7C3AED] dark:text-violet-400 uppercase tracking-wider\">\n                <th class=\"px-6 py-3.5\">Colaborador</th>\n                <th class=\"px-6 py-3.5\">Aplicación</th>\n                <th class=\"px-6 py-3.5\">Estado Permiso</th>\n                <th class=\"px-6 py-3.5\">Última Actualización</th>\n                <th class=\"px-6 py-3.5 text-center\">Acción Directa</th>\n              </tr>\n            </thead>\n            <tbody class=\"divide-y divide-slate-100 dark:divide-slate-800/50\">\n              <tr \n                v-for=\"acceso in accesos\" \n                :key=\"acceso.id\"\n                class=\"hover:bg-slate-50/30 dark:hover:bg-slate-800/10 transition-colors\"\n              >\n                <!-- Colaborador -->\n                <td class=\"px-6 py-4\">\n                  <div class=\"flex flex-col\">\n                    <span class=\"font-bold text-slate-800 dark:text-slate-200 text-sm leading-snug\">\n                      {{ acceso.colaborador.nombre }}\n                    </span>\n                    <span class=\"text-[11px] text-slate-400 dark:text-slate-500 font-mono mt-0.5\">\n                      {{ acceso.colaborador.correo }}\n                    </span>\n                  </div>\n                </td>\n\n                <!-- Aplicación -->\n                <td class=\"px-6 py-4\">\n                  <div class=\"flex flex-col\">\n                    <span class=\"font-bold text-brand-purple dark:text-violet-400 text-sm leading-snug\">\n                      {{ acceso.aplicacion.nombre }}\n                    </span>\n                    <span class=\"text-xs text-slate-450 dark:text-slate-500 mt-0.5 max-w-xs leading-normal\">\n                      {{ acceso.aplicacion.descripcion }}\n                    </span>\n                  </div>\n                </td>\n\n                <!-- Estado Permiso -->\n                <td class=\"px-6 py-4\">\n                  <span \n                    class=\"inline-block px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase text-center border\"\n                    :class=\"acceso.estado === 'Activo' \n                      ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' \n                      : 'bg-rose-500/10 text-rose-400 border-rose-500/30'\"\n                  >\n                    {{ acceso.estado === 'Activo' ? 'Habilitado' : 'Revocado' }}\n                  </span>\n                </td>\n\n                <!-- Última Actualización -->\n                <td class=\"px-6 py-4 text-xs font-medium text-slate-400 font-mono\">\n                  {{ formatDate(acceso.actualizado_en) }}\n                </td>\n\n                <!-- Acción Directa -->\n                <td class=\"px-6 py-4 text-center\">\n                  <button \n                    @click=\"handleToggleAcceso(acceso)\"\n                    class=\"px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all border\"\n                    :class=\"acceso.estado === 'Activo' \n                      ? 'bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 border-rose-500/30' \n                      : 'bg-violet-500/10 hover:bg-violet-500/20 text-violet-300 border-violet-500/30'\"\n                  >\n                    {{ acceso.estado === 'Activo' ? 'Revocar Acceso' : 'Otorgar Acceso' }}\n                  </button>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n\n          <div v-if=\"accesos?.length === 0\" class=\"text-center py-12 text-slate-400 text-sm italic\">\n            Ningún permiso o acceso coincide con el filtro de búsqueda.\n          </div>\n        </div>\n      </div>\n\n      <!-- Panel de Conceder Acceso (Formulario) -->\n      <div class=\"lg:col-span-4 glass-card p-6 bg-slate-900/60 border border-slate-800 shadow-sm\">\n        <div class=\"pb-4 mb-5 border-b border-slate-800 flex items-center gap-2\">\n          <span class=\"text-lg\">➕</span>\n          <h2 class=\"text-base font-extrabold text-violet-400 font-sans tracking-wide uppercase\">\n            Conceder Acceso\n          </h2>\n        </div>\n\n        <form @submit.prevent=\"handleConcederAcceso\" class=\"space-y-5\">\n          <!-- Campo Colaborador -->\n          <div>\n            <label class=\"block text-[10px] font-extrabold text-violet-400 uppercase tracking-wider mb-2\">\n              Colaborador\n            </label>\n            <select \n              v-model=\"selectedColaborador\"\n              class=\"w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-white focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500\"\n            >\n              <option value=\"\">-- Seleccionar Colaborador --</option>\n              <option v-for=\"c in colaboradores\" :key=\"c.id\" :value=\"c.id\">\n                {{ c.nombre }} ({{ c.correo }})\n              </option>\n            </select>\n          </div>\n\n          <!-- Campo Aplicación Corporativa -->\n          <div>\n            <label class=\"block text-[10px] font-extrabold text-violet-400 uppercase tracking-wider mb-2\">\n              Aplicación Corporativa\n            </label>\n            <select \n              v-model=\"selectedAplicacion\"\n              class=\"w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-white focus:outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500\"\n            >\n              <option value=\"\">-- Seleccionar Aplicación --</option>\n              <option v-for=\"app in aplicaciones\" :key=\"app.id\" :value=\"app.id\">\n                {{ app.nombre }}\n              </option>\n            </select>\n          </div>\n\n          <!-- Botón de Envío -->\n          <div class=\"pt-2\">\n            <button \n              type=\"submit\"\n              :disabled=\"isSubmitting\"\n              class=\"w-full bg-violet-600 hover:bg-violet-500 disabled:opacity-55 text-white font-extrabold py-3 px-5 rounded-xl transition-all shadow-md text-sm tracking-wide\"\n            >\n              {{ isSubmitting ? 'Otorgando...' : 'Otorgar Acceso de Seguridad' }}\n            </button>\n          </div>\n        </form>\n      </div>\n\n    </div>\n\n    <!-- Toast Notification -->\n    <Transition name=\"slide-up\">\n      <div v-if=\"toast\" class=\"fixed bottom-5 right-5 z-50 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-xl flex items-center gap-3 border border-slate-800\">\n        <span class=\"w-2 h-2 rounded-full bg-brand-purple animate-pulse\"></span>\n        <p class=\"text-sm font-semibold\">{{ toastMessage }}</p>\n      </div>\n    </Transition>\n  </div>\n</template>\n\n<style scoped>\n.slide-up-enter-active,\n.slide-up-leave-active {\n  transition: all 0.3s ease-out;\n}\n\n.slide-up-enter-from {\n  opacity: 0;\n  transform: translateY(30px);\n}\n\n.slide-up-leave-to {\n  opacity: 0;\n  transform: translateY(30px);\n}\n</style>\n"],"version":3}