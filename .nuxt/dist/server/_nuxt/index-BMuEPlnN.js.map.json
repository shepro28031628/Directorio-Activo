{"file":"index-BMuEPlnN.js","mappings":";;;;;;AAGA,UAAM,YAAY,IAAI,SAAS;AAC/B,UAAM,kBAAkB,IAAI,4CAA4C;AACxE,UAAM,SAAS,IAAI,KAAK;AACxB,UAAM,gBAAgB,IAAI,uBAAuB;;mBAkB1CA,eAAAC,WAAA,EAAA,OAAM,sBAAA,GAAqB,MAAA,CAAA,ocAelB,UAAA,UAAS,YAAA,yCAAA,uCAAA,qGAAA,CAAA,oVAQT,UAAA,UAAS,WAAA,yCAAA,uCAAA,qGAAA,CAAA;UAQV,UAAA,UAAS,WAAA;ioCAkBgD,cAAA,KAAa,uEAAsD,gBAAA,KAAe,qhBAOzI,OAAA,QAAM,cAAA,QAAA;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps"],"sources":["../../../../pages/enrolamiento/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport { ref, onMounted } from 'vue'\n\nconst activeTab = ref('desktop')\nconst enrollmentToken = ref('tok_directorio_activo_ren_bf78a4c9e31d2026')\nconst copied = ref(false)\nconst currentOrigin = ref('http://localhost:3000')\n\nonMounted(() => {\n  if (typeof window !== 'undefined') {\n    currentOrigin.value = window.location.origin\n  }\n})\n\nconst copyToClipboard = () => {\n  navigator.clipboard.writeText(`powershell -ExecutionPolicy Bypass -Command \"iwr -useb ${currentOrigin.value}/agent/install.ps1 | iex; Enroll-Device -Token '${enrollmentToken.value}'\"`)\n  copied.value = true\n  setTimeout(() => {\n    copied.value = false\n  }, 3000)\n}\n</script>\n\n<template>\n  <div class=\"space-y-6 max-w-4xl\">\n    \n    <!-- Encabezado -->\n    <div>\n      <h1 class=\"text-3xl font-extrabold tracking-tight text-slate-900 font-sans\">\n        Centro de Enrolamiento <span class=\"text-brand-purple\">MDM</span>\n      </h1>\n      <p class=\"text-slate-500 text-sm mt-1\">Registra e instala los agentes de seguridad para enrolar estaciones de trabajo y dispositivos móviles en la red corporativa.</p>\n    </div>\n\n    <!-- Navegación por Pestañas -->\n    <div class=\"flex gap-2 p-1 bg-slate-200/50 rounded-xl max-w-md border border-slate-200/60\">\n      <button \n        @click=\"activeTab = 'desktop'\"\n        class=\"flex-1 py-2 px-4 rounded-lg text-xs font-bold transition-all flex items-center justify-center gap-2\"\n        :class=\"activeTab === 'desktop' ? 'bg-white text-brand-purple shadow-sm' : 'text-slate-600 hover:text-slate-900'\"\n      >\n        <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"/></svg>\n        Estaciones Desktop (PCs)\n      </button>\n      <button \n        @click=\"activeTab = 'mobile'\"\n        class=\"flex-1 py-2 px-4 rounded-lg text-xs font-bold transition-all flex items-center justify-center gap-2\"\n        :class=\"activeTab === 'mobile' ? 'bg-white text-brand-purple shadow-sm' : 'text-slate-600 hover:text-slate-900'\"\n      >\n        <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z\"/></svg>\n        Dispositivos Móviles (Android/iOS)\n      </button>\n    </div>\n\n    <!-- Pestaña Desktop -->\n    <div v-if=\"activeTab === 'desktop'\" class=\"space-y-6\">\n      \n      <!-- Guía de instalación -->\n      <div class=\"bg-white p-6 rounded-2xl border border-brand-border shadow-sm space-y-6\">\n        <h2 class=\"text-md font-extrabold text-slate-800 flex items-center gap-2\">\n          <span class=\"p-1 bg-violet-50 text-brand-purple rounded-lg\">1</span>\n          Instalación del Agente Remoto (Windows / macOS)\n        </h2>\n\n        <p class=\"text-xs text-slate-500 leading-relaxed\">\n          Para registrar una computadora en la consola MDM, ejecuta la utilidad de instalación silenciosa en una terminal de comandos con permisos de administrador. El script instalará el daemon de Python, configurará el servicio local de inicio automático y registrará el token seguro de comunicación.\n        </p>\n\n        <!-- Script de instalación -->\n        <div class=\"space-y-2\">\n          <label class=\"text-xs font-bold text-slate-600 block\">Comando PowerShell de Registro Único (Windows)</label>\n          <div class=\"bg-slate-950 p-4 rounded-2xl border border-slate-800 text-slate-300 font-mono text-xs flex justify-between items-center gap-4 relative group\">\n            <span class=\"overflow-x-auto whitespace-nowrap scrollbar-thin text-brand-purple hover:text-violet-400 select-all p-1 pr-8\">\n              powershell -ExecutionPolicy Bypass -Command \"iwr -useb {{ currentOrigin }}/agent/install.ps1 | iex; Enroll-Device -Token '{{ enrollmentToken }}'\"\n            </span>\n            <button \n              @click=\"copyToClipboard\"\n              class=\"bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white px-3 py-1.5 rounded-xl text-[10px] font-bold transition flex items-center gap-1.5 shrink-0\"\n            >\n              <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3\"/></svg>\n              {{ copied ? '¡Copiado!' : 'Copiar' }}\n            </button>\n          </div>\n        </div>\n\n        <!-- Alerta de seguridad token -->\n        <div class=\"p-4 rounded-xl bg-amber-50 border border-amber-200/60 text-xs text-amber-800 leading-relaxed\">\n          <strong>Advertencia de Seguridad:</strong> Este token es único para el tenant de Directorio Activo Ren. No compartas este script con personas externas, ya que permite enrolar cualquier dispositivo de forma automática con políticas predeterminadas de la organización.\n        </div>\n      </div>\n\n      <!-- Pasos posteriores -->\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        <div class=\"bg-white p-5 rounded-2xl border border-brand-border shadow-sm space-y-2\">\n          <h3 class=\"font-extrabold text-slate-800 text-xs flex items-center gap-1.5\">\n            <span class=\"w-5 h-5 rounded-full bg-slate-100 flex items-center justify-center text-[10px] text-slate-600 font-black\">1</span>\n            Ejecución del Script\n          </h3>\n          <p class=\"text-[11px] text-slate-500 leading-relaxed\">Ejecuta el bloque PowerShell o descarga el binario compilado de configuración.</p>\n        </div>\n        <div class=\"bg-white p-5 rounded-2xl border border-brand-border shadow-sm space-y-2\">\n          <h3 class=\"font-extrabold text-slate-800 text-xs flex items-center gap-1.5\">\n            <span class=\"w-5 h-5 rounded-full bg-slate-100 flex items-center justify-center text-[10px] text-slate-600 font-black\">2</span>\n            Aprobación del Token\n          </h3>\n          <p class=\"text-[11px] text-slate-500 leading-relaxed\">El servidor valida la clave y vincula el dispositivo con el colaborador asignado en Jira.</p>\n        </div>\n        <div class=\"bg-white p-5 rounded-2xl border border-brand-border shadow-sm space-y-2\">\n          <h3 class=\"font-extrabold text-slate-800 text-xs flex items-center gap-1.5\">\n            <span class=\"w-5 h-5 rounded-full bg-slate-100 flex items-center justify-center text-[10px] text-slate-600 font-black\">3</span>\n            Inicio Telemetría\n          </h3>\n          <p class=\"text-[11px] text-slate-500 leading-relaxed\">El equipo aparece inmediatamente en \"Dispositivos Enrolados\" reportando ping de salud.</p>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- Pestaña Mobile -->\n    <div v-else class=\"space-y-6\">\n      <div class=\"bg-white p-6 rounded-2xl border border-brand-border shadow-sm grid grid-cols-1 md:grid-cols-2 gap-8 items-center\">\n        \n        <!-- Instrucciones Mobile -->\n        <div class=\"space-y-5\">\n          <h2 class=\"text-md font-extrabold text-slate-800 flex items-center gap-2\">\n            <span class=\"p-1 bg-violet-50 text-brand-purple rounded-lg\">2</span>\n            Enrolar Dispositivo Móvil Corporativo\n          </h2>\n          <p class=\"text-xs text-slate-500 leading-relaxed\">\n            Los celulares y tablets de la empresa pueden ser controlados a nivel de políticas MDM. Escanea el código QR desde el navegador nativo del dispositivo (Safari en iOS o Google Chrome en Android) para descargar el perfil corporativo verificado e instalar los certificados raíces de seguridad.\n          </p>\n\n          <div class=\"space-y-3\">\n            <div class=\"flex items-start gap-3\">\n              <span class=\"w-5 h-5 rounded-full bg-violet-100 text-brand-purple flex items-center justify-center text-xs font-bold shrink-0 mt-0.5\">&beta;</span>\n              <p class=\"text-xs text-slate-600\"><strong>iOS:</strong> Descarga el archivo de perfil (.mobileconfig) y acéptalo en Configuración &gt; VPN y Administración de Dispositivos.</p>\n            </div>\n            <div class=\"flex items-start gap-3\">\n              <span class=\"w-5 h-5 rounded-full bg-violet-100 text-brand-purple flex items-center justify-center text-xs font-bold shrink-0 mt-0.5\">&beta;</span>\n              <p class=\"text-xs text-slate-600\"><strong>Android:</strong> Habilita la administración de dispositivos de trabajo al configurar el perfil de Android Enterprise.</p>\n            </div>\n          </div>\n\n          <button class=\"bg-brand-purple hover:bg-brand-purpleHover text-white px-4 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2\">\n            <svg class=\"w-4.5 h-4.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4\"/></svg>\n            Descargar Perfil de Configuración Mobile\n          </button>\n        </div>\n\n        <!-- Simulador de Escaneo QR -->\n        <div class=\"flex flex-col items-center justify-center bg-slate-50 p-6 rounded-2xl border border-slate-200/50\">\n          <div class=\"bg-white p-4 rounded-xl shadow-md border border-slate-100 flex items-center justify-center w-48 h-48 relative\">\n            \n            <!-- SVG QR Code Generator Mock para lucir extremadamente premium -->\n            <svg class=\"w-40 h-40 text-slate-800\" viewBox=\"0 0 100 100\" fill=\"currentColor\">\n              <!-- Corner Anchor Top Left -->\n              <rect x=\"5\" y=\"5\" width=\"25\" height=\"25\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\" />\n              <rect x=\"10\" y=\"10\" width=\"15\" height=\"15\" />\n              \n              <!-- Corner Anchor Top Right -->\n              <rect x=\"70\" y=\"5\" width=\"25\" height=\"25\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\" />\n              <rect x=\"75\" y=\"10\" width=\"15\" height=\"15\" />\n              \n              <!-- Corner Anchor Bottom Left -->\n              <rect x=\"5\" y=\"70\" width=\"25\" height=\"25\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\" />\n              <rect x=\"10\" y=\"75\" width=\"15\" height=\"15\" />\n              \n              <!-- Mock QR Noise points -->\n              <rect x=\"40\" y=\"5\" width=\"5\" height=\"10\" />\n              <rect x=\"50\" y=\"15\" width=\"10\" height=\"5\" />\n              <rect x=\"45\" y=\"25\" width=\"15\" height=\"5\" />\n              <rect x=\"5\" y=\"40\" width=\"10\" height=\"5\" />\n              <rect x=\"20\" y=\"45\" width=\"5\" height=\"15\" />\n              <rect x=\"35\" y=\"40\" width=\"20\" height=\"20\" />\n              <rect x=\"65\" y=\"40\" width=\"5\" height=\"5\" />\n              <rect x=\"80\" y=\"45\" width=\"15\" height=\"5\" />\n              <rect x=\"85\" y=\"55\" width=\"10\" height=\"10\" />\n              <rect x=\"40\" y=\"70\" width=\"5\" height=\"15\" />\n              <rect x=\"55\" y=\"75\" width=\"10\" height=\"5\" />\n              <rect x=\"50\" y=\"85\" width=\"20\" height=\"10\" />\n              <rect x=\"80\" y=\"80\" width=\"15\" height=\"15\" />\n            </svg>\n            \n            <!-- Logo de la aplicación flotando en el medio del QR -->\n            <div class=\"absolute inset-0 m-auto w-10 h-10 bg-brand-purple text-white rounded-lg flex items-center justify-center font-bold border-4 border-white shadow-md text-xs\">\n              MDM\n            </div>\n          </div>\n          \n          <span class=\"text-[10px] text-slate-400 font-bold tracking-widest uppercase mt-4 block\">Escanear para Enrolar</span>\n          <p class=\"text-[9px] text-slate-400 text-center mt-1\">Este QR contiene el token firmado digitalmente.</p>\n        </div>\n\n      </div>\n    </div>\n\n  </div>\n</template>\n"],"version":3}